{
  "name": "odx",
  "displayName": "ODX",
  "description": "ODX Chat",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:odx.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odx",
          "title": "ODX",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "odx": [
        {
          "type": "webview",
          "id": "odx.chatView",
          "name": "ODX Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "typescript": "^6.0.3"
  }
}